                    tracked, aliveAt, deadSince = boss, os.clock(), nil
                    State.BossAlive = boss
                    interval = Config.BossScan.TrackInterval
                end
            end
        end)
        task.wait(interval)
    end
end)

-- ===================== PLAYER / BOSS NPC ESP =====================
local ESP_Folder = Instance.new("Folder")
ESP_Folder.Name = "EggzyESP"
ESP_Folder.Parent = Workspace

local espKinds = { "Players", "BossNPCESP" }
local espObjects = { Players = {}, BossNPCESP = {} }
local espMatchCache = {
    Players = setmetatable({}, { __mode = "k" }),
    BossNPCESP = setmetatable({}, { __mode = "k" }),
}

local function espMatches(kind, model)
    local cache = espMatchCache[kind]
    local hit = cache[model]
    local now = os.clock()
    if hit and (hit.ok or now - hit.at < 2) then return hit.ok end
    local ok, res = pcall(Config.ESP[kind].Match, model)
    res = ok and res == true
    cache[model] = { ok = res, at = now }
    return res
end

local function espAdornee(kind, model)
    local cfg = Config.ESP[kind]
    if cfg.Adornee then
        local ok, part = pcall(cfg.Adornee, model)
        if ok and typeof(part) == "Instance" and part:IsA("BasePart") then return part end
    end
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function destroyEsp(entry)
    pcall(function() entry.gui:Destroy() end)
    if entry.highlight then
        pcall(function() entry.highlight:Destroy() end)
    end
end

local function fmtHP(n)
    if n >= 1e6 then
        return string.format("%.1fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3)
    end
    return string.format("%d", math.floor(n + 0.5))
end

local function bossDisplayName(model)
    local raw = {}
    local nt = model:FindFirstChild("npctype")
    if nt and nt:IsA("StringValue") and nt.Value ~= "" then
        raw[#raw + 1] = normalize(nt.Value)
    end
    local bd = model:FindFirstChild("bossdrop")
    if bd and bd:IsA("StringValue") and bd.Value ~= "" then
        local v = normalize(bd.Value)
        raw[#raw + 1] = v
        raw[#raw + 1] = (v:gsub("char$", ""))
    end
    for _, boss in ipairs(Config.Bosses) do
        local key = normalize(boss)
        for _, r in ipairs(raw) do
            if r == key then return boss end
        end
    end
    return model.Name
end

local function createEsp(kind, model, part)
    local color = Config.ESP[kind].Color
    local labelPart = model:FindFirstChild("Head") or part

    local gui = Instance.new("BillboardGui")
    gui.Name = "EggzyESPLabel"
    gui.Adornee = labelPart
    gui.Size = UDim2.fromOffset(200, 32)
    gui.StudsOffset = Vector3.new(0, labelPart.Size.Y / 2 + 2, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = Config.ESPSettings.MaxDistance
    gui.Parent = ESP_Folder

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 16)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = color
    nameLabel.TextStrokeTransparency = 0.3
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 13
    nameLabel.Parent = gui

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Position = UDim2.new(0, 0, 0, 16)
    infoLabel.Size = UDim2.new(1, 0, 0, 16)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(235, 235, 240)
    infoLabel.TextStrokeTransparency = 0.3
    infoLabel.Font = Enum.Font.GothamMedium
    infoLabel.TextSize = 11
    infoLabel.Parent = gui

    return { part = part, gui = gui, nameLabel = nameLabel, infoLabel = infoLabel, highlight = nil }
end

local function setHighlight(entry, model, kind, on)
    if on then
        if not entry.highlight then
            local hl = Instance.new("Highlight")
            hl.Name = "EggzyESPHighlight"
            hl.Adornee = model
            hl.FillTransparency = 1
            hl.OutlineColor = Config.ESP[kind].Color
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = ESP_Folder
            entry.highlight = hl
        end
    elseif entry.highlight then
        pcall(function() entry.highlight:Destroy() end)
        entry.highlight = nil
    end
end

local function espCandidates(kind)
    local list = {}
    if kind == "Players" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                list[#list + 1] = plr.Character
            end
        end
    else
        local folder = Workspace:FindFirstChild("npc")
        if folder then
            for _, m in ipairs(folder:GetChildren()) do
                list[#list + 1] = m
            end
        end
    end
    return list
end

local function clearEsp(kind)
    for model, entry in pairs(espObjects[kind]) do
        destroyEsp(entry)
        espObjects[kind][model] = nil
    end
end

local function scanEsp(kind)
    local objects = espObjects[kind]
    local seen = {}
    local active = {}
    local myRoot = getRoot()
    local fromPos = myRoot and myRoot.Position
    for _, model in ipairs(espCandidates(kind)) do
        if model:IsA("Model") and model ~= LocalPlayer.Character and espMatches(kind, model) then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local part = espAdornee(kind, model)
            if part and (not hum or isLiving(hum)) then
                seen[model] = true
                local entry = objects[model]
                if entry and entry.part ~= part then
                    destroyEsp(entry)
                    entry = nil
                end
                if not entry then
                    entry = createEsp(kind, model, part)
                    objects[model] = entry
                end
                local dist = fromPos and (part.Position - fromPos).Magnitude or 0
                active[#active + 1] = { model = model, entry = entry, dist = dist }

                if kind == "BossNPCESP" then
                    if not entry.name or entry.name == model.Name then
                        entry.name = bossDisplayName(model)
                    end
                else
                    entry.name = entry.name or model.Name
                end
                entry.nameLabel.Text = entry.name

                local infoText = ""
                if hum then
                    local maxHp = math.max(hum.MaxHealth, 1)
                    if scriptZeroed[hum] and hum.Health <= 0 then
                        infoText = string.format("HP ? / %s", fmtHP(maxHp))
                    else
                        local frac = math.clamp(hum.Health / maxHp, 0, 1)
                        infoText = string.format("HP %s / %s (%d%%)", fmtHP(hum.Health), fmtHP(maxHp), math.floor(frac * 100 + 0.5))
                    end
                end
                if fromPos then
                    infoText = infoText .. (infoText ~= "" and "  |  " or "") .. math.floor(dist + 0.5) .. " studs"
                end
                entry.infoLabel.Text = infoText
            end
        end
    end

    table.sort(active, function(a, b) return a.dist < b.dist end)
    for i, a in ipairs(active) do
        setHighlight(a.entry, a.model, kind, i <= Config.ESPSettings.MaxHighlights)
    end

    for model, entry in pairs(objects) do
        if not seen[model] then
            destroyEsp(entry)
            objects[model] = nil
        end
    end
end

task.spawn(function()
    while Alive do
        for _, kind in ipairs(espKinds) do
            if State.ESP[kind] then
                pcall(scanEsp, kind)
            else
                clearEsp(kind)
            end
        end
        task.wait(Config.ESPSettings.ScanInterval)
    end
end)

