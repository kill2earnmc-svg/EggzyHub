        if okE and genv then genv.EggzyResume = nil end
        T3.resumeName = flagInfo and flagInfo.name or nil
        Config.Mentor.Mission = 5
        State.Mentor = true
        T3.resume = true
        print("[EggzyMentor] resumed after server teleport: training 5 (mentor fight)")
    end
end

task.spawn(function()
    local phase, presses, nextAt = T3.resume and "t5" or "talk", 0, 0
    local t2Fails = 0
    while Alive do
        local m = Config.Mentor
        if State.Mentor and m.Mission ~= T3.progress then
            T3.progress = m.Mission
            T3.saveProgress()
        end
        if not State.Mentor then
            if phase ~= "talk" or presses ~= 0 then
                phase, presses = "talk", 0
                forceReleaseInputs()
            end
            nextAt = 0
            MentorInfo.phase = "off"
            -- switched off: the chain continues from the saved progress next time (in the fight server it stays on 5)
            m.Mission = (mentorMissionsFolder() == nil) and 5 or T3.progress
        elseif State.Grind then
            MentorInfo.phase = "paused (grind)"
        elseif os.clock() >= nextAt then
            pcall(function()
                if m.Mission >= 6 then
                    local okN, nm = pcall(detectMentorName)
                    if okN and nm and T3.progressName and T3.progressName ~= "" and nm ~= T3.progressName then
                        print("[EggzyMentor] different mentor than the saved progress (" .. T3.progressName .. " -> " .. nm .. "): chain restarts at training " .. m.StartMission)
                        m.Mission = m.StartMission
                        T3.progressName = nm
                    else
                        MentorInfo.phase = "all 5 trainings done (delete " .. m.ProgressFile .. " to restart)"
                        nextAt = os.clock() + 2
                        return
                    end
                end
                if phase == "talk" and m.Mission == 5 and mentorMissionsFolder() == nil then phase = "t5" end
                if phase == "talk" then
                    local name, source = detectMentorName()
                    if Config.Debug and (name ~= MentorInfo.name or source ~= MentorInfo.source) then
                        print("[EggzyMentor] mentor:", name, "|", source)
                    end
                    MentorInfo.name, MentorInfo.source = name, source
                    if name and T3.progressName and T3.progressName ~= "" and name ~= T3.progressName and m.Mission == T3.progress and m.Mission ~= m.StartMission then
                        print("[EggzyMentor] different mentor than the saved progress (" .. T3.progressName .. " -> " .. name .. "): chain restarts at training " .. m.StartMission)
                        m.Mission = m.StartMission
                    end
                    if name and name ~= T3.progressName then
                        T3.progressName = name
                        T3.saveProgress()
                    end
                    local remote = name and mentorRemoteFor(name)
                    local reloadNote = nil
                    if remote and m.Mission == 5 then
                        T3.markResume()
                        local okQ, whyQ = T3.queueReload()
                        if Config.Debug and whyQ ~= "already queued" then
                            print("[EggzyMentor] reload for the fight server:", okQ, whyQ)
                        end
                        if not okQ then reloadNote = whyQ end
                    end
                    if remote then
                        stopFaceLock()
                        local ok = pcall(function() remote:FireServer(LocalPlayer) end)
                        if ok then
                            local tagMission = m.Mission
                            task.delay(2, function() pcall(T3.questSnapshot, "2 s after talking, hub training " .. tagMission) end)
                            phase, presses = (m.Mission == 2 and "t2") or ((m.Mission == 3 or m.Mission == 4) and "t3") or (m.Mission == 5 and "t5wait") or "m1", 0
                            nextAt = os.clock() + ((m.Mission == 5) and m.Training5.TeleportWait or m.StartDelay)
                            MentorInfo.phase = (m.Mission == 5) and ("t5 waiting for server teleport" .. (reloadNote and (" (NO RELOAD: " .. reloadNote .. ")") or "")) or string.format("starting in ~%ds", m.StartDelay)
                            return
                        end
                    end
                    MentorInfo.phase = remote and "talk failed" or ("no remote: " .. tostring(source))
                    nextAt = os.clock() + m.Interval
                elseif phase == "t5wait" then
                    T3.clearResume()
                    phase = "talk"
                    nextAt = os.clock() + m.Interval
                elseif phase == "t5" then
                    local okFight, summary = T3.fight()
                    if Config.Debug then
                        print("[EggzyMentor] t5:", tostring(okFight), summary)
                    end
                    MentorInfo.phase = "t5 done: " .. summary
                    if okFight and (summary:find("is dead", 1, true) or summary:find("is gone", 1, true)) then
                        m.Mission = 6 -- all five trainings done; saved by the loop above
                    end
                    phase, presses = "t5done", 0
                elseif phase == "t5done" then
                    nextAt = os.clock() + 1
                elseif phase == "t2" then
                    local t = m.Training2
                    MentorInfo.phase = string.format("t2 rep %d/%d", presses + 1, t.Repeats)
                    local okRun, arrived = pcall(runTraining2)
                    if okRun and arrived then
                        presses += 1
                        t2Fails = 0
                    else
                        t2Fails += 1
                    end
                    if presses >= t.Repeats then
                        MentorInfo.phase = "t2 done"
                        m.Mission = 3
                        phase, presses, t2Fails = "talk", 0, 0
                        nextAt = os.clock() + m.Interval
                    elseif t2Fails >= t.MaxFails then
                        MentorInfo.phase = "t2 failed (returned)"
                        phase, presses, t2Fails = "talk", 0, 0
                        nextAt = os.clock() + m.Interval
                    else
                        nextAt = os.clock() + t.RepGap
                    end
                elseif phase == "t3" then
                    local lookOnly = (m.Mission == 4)
                    local t = lookOnly and m.Training4 or m.Training3
                    local hit, why = T3.round(lookOnly)
                    if Config.Debug then
                        print(string.format("[EggzyMentor] t3/t4 round %d: done=%s (%s)", presses + 1, tostring(hit), tostring(why)))
                    end
                    if hit then
                        presses += 1
                        t2Fails = 0
                    else
                        t2Fails += 1
                    end
                    MentorInfo.phase = string.format("%s targets %d/%d", lookOnly and "t4" or "t3", presses, t.Repeats)
                    if presses >= t.Repeats then
                        MentorInfo.phase = lookOnly and "t4 done" or "t3 done"
                        m.Mission = lookOnly and 5 or 4
                        phase, presses, t2Fails = "talk", 0, 0
                        nextAt = os.clock() + m.Interval
                    elseif t2Fails >= t.MaxFails then
                        MentorInfo.phase = "t3 failed (" .. tostring(why) .. ")"
                        phase, presses, t2Fails = "talk", 0, 0
                        nextAt = os.clock() + m.Interval
                    else
                        nextAt = os.clock() + t.RoundGap
                    end
                else
                    local root, hum = getRoot()
                    if not (root and hum and hum.Health > 0)
                        or not windowFocused
                        or UserInputService:GetFocusedTextBox() then
                        nextAt = os.clock() + 0.5
                        return
                    end
                    if clickM1(m.M1Hold) then
                        presses += 1
                    end
                    MentorInfo.phase = string.format("M1 %d/%d", presses, m.M1Count)
                    if presses >= m.M1Count then
                        m.Mission = 2
                        phase, presses = "talk", 0
                        nextAt = os.clock() + m.Interval
                    else
                        nextAt = os.clock() + m.M1Period
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

-- ===================== SCROLL STEALER =====================
-- Runs only while Money Grind AND Scroll Stealer are on. When a scroll model exists that you do not own:
-- remember where you stand, hover Config.Scroll.ClickHeight studs above it looking straight down,
-- click M1 Config.Scroll.Clicks times, then put you back where you were (under the boss if the grind was
-- fighting one, otherwise the exact spot you left). Which models count as scrolls is inferred from the ESP
-- code: models in Workspace.npc or Workspace.GLOBALTIME that isScrollModel accepts, plus Workspace children
-- named like a scroll. That is not confirmed against a real drop yet.
local SC = { attempts = setmetatable({}, { __mode = "k" }), bound = false, aimPos = nil, camHeight = 10 }
local SC_BIND = "EggzyScrollAim"

function SC.candidates()
    local list, seen = {}, {}
    local function add(m, full)
        if seen[m] or not m:IsA("Model") or m:FindFirstChildOfClass("Humanoid") then return end
        local name = m.Name:lower()
        local ok
        if full then
            ok = isScrollModel(m)
        else
            ok = (name:find("scroll", 1, true) ~= nil and not name:find("mission", 1, true) and not m:FindFirstChild("missiongiver"))
                or name:sub(1, #SCROLL_PREFIX) == SCROLL_PREFIX and not name:find("mission", 1, true)
        end
        if ok then
            seen[m] = true
            list[#list + 1] = m
        end
    end
    local npc = Workspace:FindFirstChild("npc")
    if npc then for _, m in ipairs(npc:GetChildren()) do add(m, true) end end
    local gt = Workspace:FindFirstChild("GLOBALTIME")
    if gt then for _, m in ipairs(gt:GetChildren()) do add(m, true) end end
    for _, m in ipairs(Workspace:GetChildren()) do add(m, false) end
    return list
end

function SC.unbindAim()
    SC.aimPos = nil
    if SC.bound then
        SC.bound = false
        pcall(function() RunService:UnbindFromRenderStep(SC_BIND) end)
    end
end

function SC.bindAim()
    if SC.bound then return end
    SC.bound = true
    RunService:BindToRenderStep(SC_BIND, Enum.RenderPriority.Camera.Value + 1, function()
        local cam = Workspace.CurrentCamera
        if not (cam and SC.aimPos) then return end
        cam.CFrame = CFrame.lookAt(SC.aimPos + Vector3.new(0, SC.camHeight, 0), SC.aimPos, Vector3.zAxis)
    end)
end

-- Returns true when the trip ran (clicks were sent); you are always put back afterwards.
function SC.trip(model)
    local cfg = Config.Scroll
    local part = Config.ESP.ScrollESP.Adornee(model)
    if not (part and part:IsA("BasePart") and part:IsDescendantOf(Workspace)) then return false end
    local pos = part.Position
    if pos ~= pos or pos.Y < cfg.MinY or pos.Y > cfg.MaxY then return false end
    local root = getRoot()
    if not root then return false end
    local saved = root.CFrame

    State.ScrollTrip = true
    local ok, err = pcall(function()
        local hoverCF = CFrame.lookAt(pos + Vector3.new(0, cfg.ClickHeight, 0), pos, Vector3.zAxis)
        SC.camHeight = cfg.ClickHeight + 4
        SC.aimPos = pos
        SC.bindAim()
        local function hold()
            local r = getRoot()
            if r then
                r.CFrame = hoverCF
                r.AssemblyLinearVelocity = Vector3.zero
            end
        end
        local function holdFor(seconds)
            local untilT = os.clock() + seconds
            repeat
                hold()
                task.wait(0.05)
            until os.clock() >= untilT or not Alive
        end
        holdFor(cfg.Settle)
        for i = 1, cfg.Clicks do
            if not (Alive and State.Scrolls and State.Grind) then break end
            hold()
            local cam = Workspace.CurrentCamera
            if okVim and VIM and cam then
                local vp = cam.ViewportSize
                pcall(function() VIM:SendMouseMoveEvent(vp.X / 2, vp.Y / 2, game) end)
            end
            local sent = false
            for _ = 1, 10 do
                if clickM1(cfg.ClickHold) then sent = true break end
                task.wait(0.05)
            end
            if Config.Debug then
                print(string.format("[EggzyScroll] click %d/%d on %s sent=%s", i, cfg.Clicks, model.Name, tostring(sent)))
            end
            holdFor(cfg.ClickGap)
        end
    end)
    SC.unbindAim()
    local r = getRoot()
    if r then
        r.CFrame = saved
        r.AssemblyLinearVelocity = Vector3.zero
    end
    State.ScrollTrip = false
    if not ok and Config.Debug then
        print("[EggzyScroll] trip error:", err)
    end
    return ok
end

task.spawn(function()
    while Alive do
        task.wait(Config.Scroll.Scan)
        if State.Scrolls and State.Grind and not State.ScrollTrip then
            local root, hum = getRoot()
            if root and hum and hum.Health > 0 then
                local ok, list = pcall(SC.candidates)
                if ok then
                    for _, m in ipairs(list) do
                        local tries = SC.attempts[m] or 0
                        if tries < Config.Scroll.MaxAttempts and m.Parent and not Config.Scroll.OwnsScroll(m) then
                            SC.attempts[m] = tries + 1
                            if Config.Debug then
                                print(string.format("[EggzyScroll] scroll %s (attempt %d/%d)", m.Name, tries + 1, Config.Scroll.MaxAttempts))
                            end
                            pcall(SC.trip, m)
                            task.wait(Config.Scroll.AttemptDelay)
                            break
                        end
                    end
                end
            end
        end
    end
end)

