-- Holds Space for `hold` seconds and also sets Humanoid.Jump, so it works whether the game
-- reads the key or the humanoid. The key is always released, even on panic or toggle-off.
local function holdJump(hold)
    local deadline = os.clock() + 2
    while pressing and os.clock() < deadline do
        task.wait(0.05)
    end
    if pressing then return false end
    pressing = true
    local space = Enum.KeyCode.Space
    heldKeys[space] = true
    pcall(sendKey, true, space)
    -- Only the real Space key is held. Setting Humanoid.Jump here made a normal jump on top of the tree jump.
    local sawReady = false
    local startedAt = os.clock()
    local reported = false
    local untilT = startedAt + hold
    while Alive and State.Mentor and os.clock() < untilT do
        if LocalPlayer:GetAttribute("treejumpready") == true then sawReady = true end
        if Config.Debug and not reported and os.clock() - startedAt >= 0.25 then
            reported = true
            local r, h = getRoot()
            local look = r and r.CFrame.LookVector
            local heading = look and (math.deg(math.atan2(look.X, -look.Z)) % 360)
            print(string.format("[EggzyMentor] Space held 0.25s: stick=%s ready=%s state=%s pos=%s heading=%s",
                tostring(r and r:FindFirstChild("stick") ~= nil), tostring(sawReady),
                tostring(h and h:GetState()), tostring(r and r.Position),
                heading and string.format("%.1f", heading) or "?"))
        end
        task.wait(0.05)
    end
    if heldKeys[space] then
        heldKeys[space] = nil
        pcall(sendKey, false, space)
    end
    pressing = false
    return true, sawReady
end

-- Training 2: teleport to TeleportTo, wait until the character is at WaitAt, hold jump,
-- wait AfterJumpWait, then teleport to ReturnTo.
-- Returns true when the character reached WaitAt. Always attempts the return teleport.
local mentorFaceLock = false

local function headingDirection(deg)
    local r = math.rad(deg)
    return Vector3.new(math.sin(r), 0, -math.cos(r))
end

-- Facing lock. Every render frame, after the camera script has run, it
--   1) turns Humanoid.AutoRotate off so the humanoid stops steering the character,
--   2) sets the root CFrame to the heading and holds it with a BodyGyro (beats scripts that add torque),
--   3) turns the camera to the same heading (keeps its pitch), because many games rotate the character toward the camera.
-- It is released when the loop talks to the mentor again, when Auto Mentor / training 2 is switched off, or on unload.
local FACE_BIND = "EggzyMentorFace"
local faceGyro, faceBound = nil, false
local faceSuspended = false

-- Suspended during the tree jump itself: the game builds its own AlignPosition / AlignOrientation then,
-- and a per-frame CFrame + BodyGyro rewrite from us fights it (SpaceTest worked only with nothing fighting).
local function suspendFaceLock()
    faceSuspended = true
    if faceGyro then
        pcall(function() faceGyro:Destroy() end)
        faceGyro = nil
    end
end

local function stopFaceLock()
    mentorFaceLock = false
    faceSuspended = false
    if faceBound then
        faceBound = false
        pcall(function() RunService:UnbindFromRenderStep(FACE_BIND) end)
    end
    if faceGyro then
        pcall(function() faceGyro:Destroy() end)
        faceGyro = nil
    end
    local _, hum = getRoot()
    if hum then pcall(function() hum.AutoRotate = true end) end
end

local function applyFace()
    if not (Alive and State.Mentor and Config.Mentor.Mission == 2) then
        stopFaceLock()
        return
    end
    if faceSuspended then return end
    local root, hum = getRoot()
    if not root then return end
    local dir = headingDirection(Config.Mentor.Training2.Facing)
    local pos = root.Position
    local cf = CFrame.lookAt(pos, pos + dir)
    if hum then hum.AutoRotate = false end
    root.CFrame = cf
    root.AssemblyAngularVelocity = Vector3.zero
    if not (faceGyro and faceGyro.Parent == root) then
        if faceGyro then pcall(function() faceGyro:Destroy() end) end
        faceGyro = Instance.new("BodyGyro")
        faceGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        faceGyro.P = 9e4
        faceGyro.Parent = root
    end
    faceGyro.CFrame = cf
    local cam = Workspace.CurrentCamera
    if cam then
        local cl = cam.CFrame.LookVector
        local horiz = math.sqrt(math.max(0, 1 - cl.Y * cl.Y))
        local look = Vector3.new(dir.X * horiz, cl.Y, dir.Z * horiz)
        local camPos = cam.CFrame.Position
        cam.CFrame = CFrame.lookAt(camPos, camPos + look)
    end
end

local function startFaceLock()
    mentorFaceLock = true
    if not faceBound then
        faceBound = true
        RunService:BindToRenderStep(FACE_BIND, Enum.RenderPriority.Camera.Value + 1, applyFace)
    end
end

local function runTraining2()
    local t = Config.Mentor.Training2
    local root = getRoot()
    if not root then return false end
    local dir = headingDirection(t.Facing)
    startFaceLock()

    local function goBack()
        local r = getRoot()
        if r then
            if Config.Debug then
                print(string.format("[EggzyMentor] %.2f BACK-TP from %s to %s", os.clock(), tostring(r.Position), tostring(t.ReturnTo)))
                task.delay(0.4, function()
                    local r2 = getRoot()
                    if r2 then
                        print(string.format("[EggzyMentor] %.2f 0.4s after back-tp, pos=%s (moved %.1f studs from ReturnTo)",
                            os.clock(), tostring(r2.Position), (r2.Position - t.ReturnTo).Magnitude))
                    end
                end)
            end
            r.CFrame = CFrame.lookAt(t.ReturnTo, t.ReturnTo + dir)
            r.AssemblyLinearVelocity = Vector3.zero
        end
    end
    local function stillOn()
        return Alive and State.Mentor and not State.Grind
    end

    if Config.Debug then
        print(string.format("[EggzyMentor] %.2f SPOT-TP from %s to %s", os.clock(), tostring(root.Position), tostring(t.TeleportTo)))
    end
    root.CFrame = CFrame.lookAt(t.TeleportTo, t.TeleportTo + dir)
    root.AssemblyLinearVelocity = Vector3.zero

    local arrived = false
    local ok, err = pcall(function()
        MentorInfo.phase = "t2 waiting to land"
        local deadline = os.clock() + t.ArriveTimeout
        while stillOn() and os.clock() < deadline do
            local r = getRoot()
            if r and (r.Position - t.WaitAt).Magnitude <= t.ArriveRadius then
                arrived = true
                break
            end
            task.wait(t.Poll)
        end
        if arrived then
            MentorInfo.phase = "t2 jump"
            task.wait(t.SettleAfterLand)
            suspendFaceLock()
            local r0, h0 = getRoot()
            if h0 then pcall(function() h0.AutoRotate = true end) end
            local _, sawReady = holdJump(t.JumpHold)
            task.delay(0.3, function()
                if Config.Debug then
                    print("[EggzyMentor] tree jump: treejumpready seen while holding =", sawReady,
                        "| injump 0.3s after release =", tostring(LocalPlayer:GetAttribute("injump")))
                end
            end)
            MentorInfo.phase = "t2 waiting to return"
            local untilT = os.clock() + t.AfterJumpWait
            while stillOn() and os.clock() < untilT do
                task.wait(0.05)
            end
        end
    end)
    goBack()
    faceSuspended = false
    if not ok and Config.Debug then
        print("[EggzyMentor] training 2 error:", err)
    end
    if not arrived and Config.Debug then
        print("[EggzyMentor] training 2: never reached WaitAt, teleported back")
    end
    return arrived
end

-- Training 3: look at the kunaiaim target, throw with M1, count a hit when the target is removed,
-- replaced by a new instance, or jumps away. One table keeps the main chunk under Luau's local limit.
local T3 = { aimBound = false, aimTarget = nil, aimUp = false, lastThrowAt = 0 }
local T3_BIND = "EggzyMentorAim"

function T3.findTarget()
