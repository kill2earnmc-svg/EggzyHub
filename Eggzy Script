track(RunService.RenderStepped:Connect(function()
    if not State.Fly then return end
    local root, hum = getRoot()
    local cam = Workspace.CurrentCamera
    if not (root and cam) then return end
    if not (flyBV and flyBV.Parent == root and flyBG and flyBG.Parent == root) then
        if os.clock() - lastFlyHeal < 0.5 then return end
        lastFlyHeal = os.clock()
        ensureFlyMovers(root, hum)
    end

    if State.Grind then
        local pos = cam.CFrame.Position
        cam.CFrame = CFrame.lookAt(pos, root.Position + Vector3.new(0, 90, 0))
    end

    local dir = Vector3.zero
    local U = UserInputService
    if U:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
    if U:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
    if U:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
    if U:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
    if U:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
    if U:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
    flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * Config.FlySpeed or Vector3.zero
    flyBG.CFrame = cam.CFrame
end))

