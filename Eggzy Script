local function makeButton(text, x, w)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(w, 24)
    b.Position = UDim2.fromOffset(x, 32)
    b.BackgroundColor3 = Color3.fromRGB(52, 52, 58)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(230, 230, 235)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 12
    b.AutoButtonColor = true
    b.BorderSizePixel = 0
    b.Parent = win
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
    return b
end

local pauseBtn = makeButton("Pause", 10, 60)
local clearBtn = makeButton("Clear", 76, 60)
local copyBtn = makeButton("Copy all", 142, 76)
local copyLastBtn = makeButton("Copy last", 224, 76)
local saveBtn = makeButton("Save file", 306, 76)
local unmuteBtn = makeButton("Unmute all", 388, 82)

local filterBox = Instance.new("TextBox")
filterBox.Size = UDim2.fromOffset(530, 24)
filterBox.Position = UDim2.fromOffset(10, 62)
filterBox.BackgroundColor3 = Color3.fromRGB(44, 44, 50)
filterBox.PlaceholderText = "filter (remote name or text), e.g. talk"
filterBox.Text = ""
filterBox.TextColor3 = Color3.fromRGB(235, 235, 240)
filterBox.PlaceholderColor3 = Color3.fromRGB(140, 140, 150)
filterBox.Font = Enum.Font.Gotham
filterBox.TextSize = 12
filterBox.ClearTextOnFocus = false
filterBox.TextXAlignment = Enum.TextXAlignment.Left
filterBox.BorderSizePixel = 0
filterBox.Parent = win
Instance.new("UICorner", filterBox).CornerRadius = UDim.new(0, 5)

local list = Instance.new("ScrollingFrame")
list.Size = UDim2.new(1, -20, 1, -98)
list.Position = UDim2.fromOffset(10, 92)
list.BackgroundColor3 = Color3.fromRGB(22, 22, 25)
list.BorderSizePixel = 0
list.ScrollBarThickness = 5
list.CanvasSize = UDim2.new()
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.Parent = win
Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)

local layout = Instance.new("UIListLayout", list)
layout.Padding = UDim.new(0, 4)
layout.SortOrder = Enum.SortOrder.LayoutOrder

local function lineMatches(entry)
    if Filter == "" then return true end
    local f = Filter:lower()
    return entry.text:lower():find(f, 1, true) ~= nil or entry.call:lower():find(f, 1, true) ~= nil
end

local function rebuild()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local order = 0
    for _, entry in ipairs(Lines) do
        if lineMatches(entry) then
            order += 1
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, -8, 0, 0)
            row.AutomaticSize = Enum.AutomaticSize.Y
            row.BackgroundColor3 = Color3.fromRGB(36, 36, 41)
            row.BorderSizePixel = 0
            row.Text = entry.text .. "\n" .. entry.call .. "\n(click to copy this call)"
            row.TextColor3 = Color3.fromRGB(215, 215, 222)
            row.Font = Enum.Font.Code
            row.TextSize = 12
            row.TextWrapped = true
            row.TextXAlignment = Enum.TextXAlignment.Left
            row.TextYAlignment = Enum.TextYAlignment.Top
            row.LayoutOrder = order
            row.AutoButtonColor = false
            row.Parent = list
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)
            row.MouseButton1Click:Connect(function()
                if setclipboard then pcall(setclipboard, entry.call) end
            end)
        end
    end
    list.CanvasPosition = Vector2.new(0, 1e6)
end

local dirty = false
onLogChanged = function() dirty = true end

local drainConn = RunService.Heartbeat:Connect(function()
    local taken = 0
    while #Queue > 0 and taken < 60 do
        local item = table.remove(Queue, 1)
        taken += 1
        pcall(handleCall, item[1], item[2], item[3], item[4])
    end
    if dirty then
        dirty = false
        local okR, err = pcall(rebuild)
        if not okR then warn("[WrenchSpy] window update failed: " .. tostring(err)) end
    end
end)

local function allText(filtered)
    local out = {}
    for _, entry in ipairs(Lines) do
        if not filtered or lineMatches(entry) then
            out[#out + 1] = entry.text .. "\n" .. entry.call
        end
    end
    return table.concat(out, "\n\n")
end

filterBox:GetPropertyChangedSignal("Text"):Connect(function()
    Filter = filterBox.Text
    rebuild()
end)

pauseBtn.MouseButton1Click:Connect(function()
    Paused = not Paused
    pauseBtn.Text = Paused and "Resume" or "Pause"
end)
clearBtn.MouseButton1Click:Connect(function()
    table.clear(Lines)
    table.clear(FullLog)
    rebuild()
end)
copyBtn.MouseButton1Click:Connect(function()
    if setclipboard then pcall(setclipboard, allText(true)) end
end)
copyLastBtn.MouseButton1Click:Connect(function()
    local last = Lines[#Lines]
    if last and setclipboard then pcall(setclipboard, last.text .. "\n" .. last.call) end
end)
saveBtn.MouseButton1Click:Connect(function()
    if writefile then
        pcall(writefile, Config.OutFile, table.concat(FullLog, "\n\n"))
        print("[WrenchSpy] saved " .. #FullLog .. " calls to " .. Config.OutFile)
    end
end)
unmuteBtn.MouseButton1Click:Connect(function()
    table.clear(Muted)
    table.clear(Counters)
end)

local keyConn = UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        win.Visible = not win.Visible
    end
end)

-- ---------------------------------------------------------------- stop (the metamethod hook cannot be safely removed; it just passes through once Alive is false)
local function stop()
    Alive = false
    onLogChanged = nil
    pcall(function() keyConn:Disconnect() end)
    pcall(function() drainConn:Disconnect() end)
    pcall(function() gui:Destroy() end)
end

if getgenv then
    getgenv().WrenchSpyInstance = { Stop = stop }
end

print("[WrenchSpy] running. Do the action once (e.g. talk to the rank-up NPC), then press Copy last / Copy all. F8 hides the window.")
