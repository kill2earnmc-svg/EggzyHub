local rawPrint = print
local LOG_FILE = "EggzyHub_log.txt"
local logBuf = {}
if isfile and readfile and isfile(LOG_FILE) then
    local okR, old = pcall(readfile, LOG_FILE)
    if okR and type(old) == "string" then
        for line in old:gmatch("[^\n]+") do logBuf[#logBuf + 1] = line end
        while #logBuf > 300 do table.remove(logBuf, 1) end
    end
end
local function print(...)
    rawPrint(...)
    local parts = {}
    for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
    logBuf[#logBuf + 1] = os.date("%X") .. " " .. table.concat(parts, " ")
    while #logBuf > 400 do table.remove(logBuf, 1) end
    if writefile then pcall(writefile, LOG_FILE, table.concat(logBuf, "\n")) end
end
