local SCROLL_PREFIX = "bossdrop"
local function isScrollModel(m)
    if not m:IsA("Model") then return false end
    if m:FindFirstChild("missiongiver") or m.Name:lower():find("mission") then return false end
    
    local nameLower = m.Name:lower()
    if nameLower:find("scroll") or nameLower:find("batarang") or nameLower:find("gscroll") then
        return true
    end
    
    if m.Parent == Workspace then
        if string.sub(nameLower, 1, #SCROLL_PREFIX) == SCROLL_PREFIX or nameLower == "globaltime" then
            return true
        end
    end
    
    local gt = Workspace:FindFirstChild("GLOBALTIME")
    if gt and m.Parent == gt then
        return true
    end

    for _, d in ipairs(m:GetDescendants()) do
        local dName = d.Name:lower()
        if dName:find("scroll") or dName == "gscroll" or dName == "scroll2" then
            return true
        end
    end

    return false
end

