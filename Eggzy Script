local function normalize(s)
    return (string.lower(s):gsub("[^%w]", ""))
end

local function bossMatches(m, key)
    local nt = m:FindFirstChild("npctype")
    if nt and nt:IsA("StringValue") and nt.Value ~= "" and normalize(nt.Value) == key then return true end
    local bd = m:FindFirstChild("bossdrop")
    if bd and bd:IsA("StringValue") and bd.Value ~= "" then
        local v = normalize(bd.Value)
        if v == key .. "char" or v == key then return true end
    end
    return false
end

local visited = setmetatable({}, { __mode = "k" })
local scriptZeroed = setmetatable({}, { __mode = "k" })

local function findBossPart(boss, fromPos)
    local key = normalize(boss)
    local folder = Workspace:FindFirstChild("npc")
    if not folder then return nil end
    local bestPart, bestModel, bestD, count = nil, nil, math.huge, 0
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and not visited[m] and bossMatches(m, key) then
            local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or m:FindFirstChildWhichIsA("BasePart", true)
            if part then
                count += 1
                local d = fromPos and (part.Position - fromPos).Magnitude or 0
                if d < bestD then bestPart, bestModel, bestD = part, m, d end
            end
        end
    end
    return bestPart, bestModel, count, bestD
end

local function placeUnder(part, height)
    if State.ScrollTrip then return false end
    local root, hum = getRoot()
    if not (root and part) then return false end
    root.CFrame = CFrame.new(part.Position + Vector3.new(0, height, 0))
    root.AssemblyLinearVelocity = Vector3.zero
    if hum then
        hum.PlatformStand = State.Fly
    end
    return true
end

local function pressKey(keyCode, hold)
    if pressing and os.clock() - pressing < 5 then return end
    pressing = os.clock()
    heldKeys[keyCode] = true
    if pcall(sendKey, true, keyCode) then
        task.wait(hold)
    end
    if heldKeys[keyCode] then
        heldKeys[keyCode] = nil
        pcall(sendKey, false, keyCode)
    end
    pressing = false
end

local function isLiving(hum)
    return hum ~= nil and (hum.Health > 0 or scriptZeroed[hum] == true)
end

local function bossState(boss)
    local folder = Workspace:FindFirstChild("npc")
    if not folder then return false, "workspace.npc missing" end
    local key = normalize(boss)
    local matched, lastHum = 0, nil
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and bossMatches(m, key) then
            matched += 1
            local hum = m:FindFirstChildOfClass("Humanoid")
            if isLiving(hum) then
                return true, "alive"
            end
            lastHum = hum or lastHum
        end
    end
    if matched == 0 then
        return false, "no matching model in workspace.npc"
    end
    if lastHum then
        return false, string.format("%d matching model(s), Humanoid Health %.0f/%.0f", matched, lastHum.Health, lastHum.MaxHealth)
    end
    return false, string.format("%d matching model(s) without a Humanoid", matched)
end

local function findAliveSelectedBoss()
    local folder = Workspace:FindFirstChild("npc")
    if not folder then return nil end
    local living = {}
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and isLiving(m:FindFirstChildOfClass("Humanoid")) then
            living[#living + 1] = m
        end
    end
    if #living == 0 then return nil end
    for _, boss in ipairs(Config.Bosses) do
        if Config.Quest.Selected[boss] then
            local key = normalize(boss)
            for _, m in ipairs(living) do
                if bossMatches(m, key) then
                    return boss
                end
            end
        end
    end
    return nil
end

local function livingBossPart(boss, fromPos)
    local folder = Workspace:FindFirstChild("npc")
    if not folder then return nil end
    local key = normalize(boss)
    local bestPart, bestD = nil, math.huge
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and bossMatches(m, key) and isLiving(m:FindFirstChildOfClass("Humanoid")) then
            local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or m:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local d = (part.Position - fromPos).Magnitude
                if d < bestD then bestPart, bestD = part, d end
            end
        end
    end
    return bestPart, bestD
end

