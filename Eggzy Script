local ESP_Folder = Instance.new("Folder")
ESP_Folder.Name = "EggzyESP"
ESP_Folder.Parent = Workspace

local espKinds = { "Players", "BossNPCESP" }
local espObjects = { Players = {}, BossNPCESP = {} }
local espMatchCache = {
    Players = setmetatable({}, { __mode = "k" }),
    BossNPCESP = setmetatable({}, { __mode = "k" }),
}

local function espMatches(kind, model)
    local cache = espMatchCache[kind]
    local hit = cache[model]
    local now = os.clock()
    if hit and (hit.ok or now - hit.at < 2) then return hit.ok end
    local ok, res = pcall(Config.ESP[kind].Match, model)
    res = ok and res == true
    cache[model] = { ok = res, at = now }
    return res
end

local function espAdornee(kind, model)
    local cfg = Config.ESP[kind]
    if cfg.Adornee then
        local ok, part = pcall(cfg.Adornee, model)
        if ok and typeof(part) == "Instance" and part:IsA("BasePart") then return part end
    end
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function destroyEsp(entry)
    pcall(function() entry.gui:Destroy() end)
    if entry.highlight then
        pcall(function() entry.highlight:Destroy() end)
    end
end

local function fmtHP(n)
    if n >= 1e6 then
        return string.format("%.1fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3)
    end
    return string.format("%d", math.floor(n + 0.5))
end

local function bossDisplayName(model)
    local raw = {}
    local nt = model:FindFirstChild("npctype")
    if nt and nt:IsA("StringValue") and nt.Value ~= "" then
        raw[#raw + 1] = normalize(nt.Value)
    end
    local bd = model:FindFirstChild("bossdrop")
    if bd and bd:IsA("StringValue") and bd.Value ~= "" then
        local v = normalize(bd.Value)
        raw[#raw + 1] = v
        raw[#raw + 1] = (v:gsub("char$", ""))
    end
    for _, boss in ipairs(Config.Bosses) do
        local key = normalize(boss)
        for _, r in ipairs(raw) do
            if r == key then return boss end
        end
    end
    return model.Name
end

