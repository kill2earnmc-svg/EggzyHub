function T3.queueReload()
    if T3.queued then return true, "already queued" end
    local okG, genvL = pcall(getgenv)
    if okG and genvL and genvL.EggzyLoaderActive then
        return true, "EggzyLoader is armed (hub does not queue a second copy)"
    end
    local q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
    if not q then return false, "executor has no queue_on_teleport" end
    local loader, note = T3.findReloadLoader()
    if not loader then return false, note end
    -- The queued script proves it ran (EggzyQueueRan.txt + a line in EggzyHub_log.txt), logs a launch failure instead of
    -- dying silently, and runs once per server (re-arming below can queue it several times).
    local code = table.concat({
        'local function logLine(msg)',
        '  pcall(function()',
        '    if not writefile then return end',
        '    local old = (isfile and isfile("EggzyHub_log.txt") and readfile("EggzyHub_log.txt")) or ""',
        '    writefile("EggzyHub_log.txt", old .. "\\n" .. os.date("%X") .. " [queued payload] " .. msg)',
        '  end)',
        'end',
        'if getgenv().EggzyPayloadJob == game.JobId then return end',
        'getgenv().EggzyPayloadJob = game.JobId',
        'pcall(function() if writefile then writefile("EggzyQueueRan.txt", os.date() .. " place " .. game.PlaceId .. " job " .. game.JobId) end end)',
        'logLine("ran in place " .. game.PlaceId .. " job " .. game.JobId)',
        'repeat task.wait() until game:IsLoaded() and game:GetService("Players").LocalPlayer',
        'getgenv().EggzyResume = "t5"',
        'local ok, err = pcall(function()',
        loader,
        'end)',
        'logLine(ok and "hub launched" or ("hub launch failed: " .. tostring(err)))',
    }, "\n")
    local okQ, err = pcall(q, code)
    if not okQ then return false, tostring(err) end
    T3.queued = true
    T3.queuePayload = code
    -- Some executors keep only the LAST queued script (your auto-relog script re-arms for that reason), and other scripts
    -- may queue their own: re-queue every 10 s while we wait for the teleport.
    task.spawn(function()
        local untilT = os.clock() + Config.Mentor.Training5.TeleportWait + 10
        while Alive and os.clock() < untilT do
            task.wait(10)
            pcall(q, code)
        end
    end)
    return true, "queued via " .. note
end

function T3.fight()
    local t, g = Config.Mentor.Training5, Config.Grind
    local function stillOn() return Alive and State.Mentor and not State.Grind end
    local mentorName = T3.resumeName or MentorInfo.name or T3.playerMentorName()
    local announced = false
    T3.questSnapshot("fight server start (mentor " .. tostring(mentorName) .. ")")

    State.Fly = true
    State.Noclip = true
    State.Kill = true
    startFly()
    T3.startAimUp(t.Offset >= 0 and -Vector3.yAxis or Vector3.yAxis) -- straight down when above the boss, straight up when under it

    local ok, result = pcall(function()
        local deadline = os.clock() + t.BossTimeout
        local aliveSince, lastQ, sawBoss = nil, 0, false
        while stillOn() and os.clock() < deadline do
            -- fly, noclip and Instant Kill must stay on the whole fight: re-assert every loop
            State.Fly = true
            State.Noclip = true
            State.Kill = true -- Instant Kill toggle (hits models in Workspace.npc within Config.Kill.Range)
            if not (flyBV and flyBV.Parent) then startFly() end

            local model, hum, part = T3.findFightBoss(mentorName)
            if model then
                sawBoss = true
                if not announced then
                    announced = true
                    local match = mentorName and model.Name:lower():find(mentorName:lower(), 1, true) ~= nil
                    print(string.format("[EggzyMentor] fight check: boss candidate %s | mentor %s | name match %s | mentor folder here: %s",
                        model.Name, tostring(mentorName), tostring(match), tostring(mentorMissionsFolder() ~= nil)))
                end
                -- dead = gone from the world, or died by itself (a Health 0 that WE wrote does not count)
                if not model.Parent or (hum.Health <= 0 and not scriptZeroed[hum]) then
                    return string.format("boss %s is dead", model.Name)
                end
                MentorInfo.phase = string.format("t5 %s %s (hp %.0f)", t.Offset >= 0 and "above" or "under", model.Name, hum.Health)
                placeUnder(part, t.Offset)
                if isLiving(hum) then
                    aliveSince = aliveSince or os.clock()
                    -- from you: press Q every 5 seconds while the boss is alive
                    if os.clock() - lastQ >= t.QPeriod then
                        lastQ = os.clock()
                        pressKey(g.Key, g.KeyHold)
                    end
                    if os.clock() - aliveSince >= t.AliveConfirm and hum.Health > 0 then
                        scriptZeroed[hum] = true
                        pcall(function() hum.Health = 0 end)
                    end
                else
                    aliveSince = nil
                end
            else
                if sawBoss then return "boss model is gone" end
                aliveSince = nil
                MentorInfo.phase = "t5 waiting for boss"
                -- boss not there yet: keep pressing Q until it shows up
                pressKey(g.Key, g.KeyHold)
                task.wait(g.KeyDelay)
            end
            task.wait(g.KillStep)
        end
        return "boss still alive at timeout, or stopped"
    end)

    T3.stopAim()
    -- Flight, noclip and Instant Kill are left ON after the fight (you said they must be on); turn them off in the Player page.
    return ok, tostring(result)
end

-- Returns true when a throw hit (target gone / replaced / moved), false otherwise, plus a reason.
function T3.round(lookOnly)
    local t = Config.Mentor.Training3
    local function stillOn() return Alive and State.Mentor and not State.Grind end

    MentorInfo.phase = "t3 looking for target"
    local target
    local deadline = os.clock() + t.FindTimeout
    while stillOn() and os.clock() < deadline do
        target = T3.findTarget()
        if target then break end
        task.wait(t.Poll)
    end
    if not target then return false, "no target found" end

    T3.startAim(target)
    local ok, hit, reason = pcall(function()
        task.wait(t.AimSettle)
        local basePos = target.Position
        if lookOnly then
            MentorInfo.phase = "t4 looking"
            local untilL = os.clock() + Config.Mentor.Training4.LookTimeout
            while stillOn() and os.clock() < untilL do
                local cur = T3.findTarget()
                if cur ~= target then
                    return true, cur and "replaced by a new instance" or "target removed"
                end
                local moved = (cur.Position - basePos).Magnitude
                if moved > t.MoveThreshold then
                    return true, string.format("target moved %.1f studs", moved)
                end
                task.wait(t.Poll)
            end
            return false, "target did not change while looking"
        end
        for throw = 1, t.MaxThrows do
            if not stillOn() then return false, "stopped" end
            MentorInfo.phase = string.format("t3 throw %d", throw)
            local cam = Workspace.CurrentCamera
            if okVim and VIM and cam then
                local vp = cam.ViewportSize
                pcall(function() VIM:SendMouseMoveEvent(vp.X / 2, vp.Y / 2, game) end)
            end
            local ready = T3.lastThrowAt + t.ThrowCooldown
            while stillOn() and os.clock() < ready do
                task.wait(0.05)
            end
            if not stillOn() then return false, "stopped" end
            T3.lastThrowAt = os.clock()
            clickM1(t.M1Hold)
            local untilT = os.clock() + t.HitWait
            while stillOn() and os.clock() < untilT do
                local cur = T3.findTarget()
                if cur ~= target then
                    return true, cur and "replaced by a new instance" or "target removed"
                end
                local moved = (cur.Position - basePos).Magnitude
                if moved > t.MoveThreshold then
                    return true, string.format("target moved %.1f studs", moved)
                end
                task.wait(t.Poll)
            end
        end
        return false, "no hit after " .. t.MaxThrows .. " throws"
    end)
    T3.stopAim()
    if not ok then return false, tostring(hit) end
    return hit, reason
end

