        if gated and gated() then
            nameLabel.TextColor3 = Theme.TextMuted
            status.Text = "GATED"
            status.BackgroundColor3 = Theme.Off
            status.TextColor3 = Theme.TextMuted
            return
        end
        nameLabel.TextColor3 = Theme.Text
        if on then
            status.Text = "ON"
            status.BackgroundColor3 = Theme.On
            status.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            status.Text = "OFF"
            status.BackgroundColor3 = Theme.Off
            status.TextColor3 = Theme.TextDim
        end
    end

    row.MouseButton1Click:Connect(function()
        if gated and gated() then render() return end
        local newVal = not getState()
        setState(newVal)
        render()
    end)
    row.MouseEnter:Connect(function()
        if not (gated and gated()) then
            row.BackgroundColor3 = Theme.SurfaceHover
        end
    end)
    row.MouseLeave:Connect(function()
        row.BackgroundColor3 = Theme.Surface
    end)

    task.spawn(function()
        while row.Parent and Alive do
            render()
            task.wait(0.5)
        end
    end)

    render()
    return render, getState
end

