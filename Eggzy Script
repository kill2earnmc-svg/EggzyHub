local function espCandidates(kind)
    local list = {}
    if kind == "Players" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                list[#list + 1] = plr.Character
            end
        end
    else
        local folder = Workspace:FindFirstChild("npc")
        if folder then
            for _, m in ipairs(folder:GetChildren()) do
                list[#list + 1] = m
            end
        end
    end
    return list
end

local function clearEsp(kind)
    for model, entry in pairs(espObjects[kind]) do
        destroyEsp(entry)
        espObjects[kind][model] = nil
    end
end

local function scanEsp(kind)
    local objects = espObjects[kind]
    local seen = {}
    local active = {}
    local myRoot = getRoot()
    local fromPos = myRoot and myRoot.Position
    for _, model in ipairs(espCandidates(kind)) do
        if model:IsA("Model") and model ~= LocalPlayer.Character and espMatches(kind, model) then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local part = espAdornee(kind, model)
            if part and (not hum or isLiving(hum)) then
                seen[model] = true
                local entry = objects[model]
                if entry and entry.part ~= part then
                    destroyEsp(entry)
                    entry = nil
                end
                if not entry then
                    entry = createEsp(kind, model, part)
                    objects[model] = entry
                end
                local dist = fromPos and (part.Position - fromPos).Magnitude or 0
                active[#active + 1] = { model = model, entry = entry, dist = dist }

                if kind == "BossNPCESP" then
                    if not entry.name or entry.name == model.Name then
                        entry.name = bossDisplayName(model)
                    end
                else
                    entry.name = entry.name or model.Name
                end
                entry.nameLabel.Text = entry.name

                local infoText = ""
                if hum then
                    local maxHp = math.max(hum.MaxHealth, 1)
                    if scriptZeroed[hum] and hum.Health <= 0 then
                        infoText = string.format("HP ? / %s", fmtHP(maxHp))
                    else
                        local frac = math.clamp(hum.Health / maxHp, 0, 1)
                        infoText = string.format("HP %s / %s (%d%%)", fmtHP(hum.Health), fmtHP(maxHp), math.floor(frac * 100 + 0.5))
                    end
                end
                if fromPos then
                    infoText = infoText .. (infoText ~= "" and "  |  " or "") .. math.floor(dist + 0.5) .. " studs"
                end
