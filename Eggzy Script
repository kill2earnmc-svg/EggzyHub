-- Reads and consumes the flag file. Returns fresh, info, why.
-- fresh = written recently AND we are in a different server (JobId changed), i.e. we were teleported, not just re-executed.
function T3.takeResumeFlag()
    local t = Config.Mentor.Training5
    local fresh, info, why = false, nil, "no flag file"
    if isfile and readfile and isfile(t.ResumeFile) then
        local okR, txt = pcall(readfile, t.ResumeFile)
        if okR and type(txt) == "string" then
            local ts, placeId, jobId, name = txt:match("^(%d+)|([^|]*)|([^|]*)|(.*)$")
            if not ts then ts = txt:match("^(%d+)$") end
            ts = tonumber(ts)
            if ts and ts > 0 then
                info = { ts = ts, placeId = placeId, jobId = jobId, name = (name and name ~= "") and name or nil }
                if math.abs(os.time() - ts) > t.ResumeWindow then
                    why = "flag is older than " .. t.ResumeWindow .. " s"
                elseif jobId and jobId ~= "" and jobId == tostring(game.JobId) then
                    why = "same server (JobId unchanged), not a teleport"
                else
                    fresh, why = true, string.format("teleported: JobId changed, place %s -> %s", tostring(placeId), tostring(game.PlaceId))
                end
            else
                why = "flag file empty"
            end
        end
    end
    T3.clearResume()
    return fresh, info, why
end

