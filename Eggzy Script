local function waitForNewCharacter(oldChar, timeout)
    local deadline = os.clock() + timeout
    while Alive and State.Grind and os.clock() < deadline do
        local c = LocalPlayer.Character
        if c and c ~= oldChar and c.Parent then
            local root = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                return c
            end
        end
        task.wait(0.2)
    end
    return nil
end

local function returnToBoss(boss)
    local t = Config.Teleport
    local height = getBossHeight(boss)
    local deadline = os.clock() + t.ReturnSeconds
    local nextQuest = 0
    while Alive and State.Grind and os.clock() < deadline do
        local root = getRoot()
        if root then
            if os.clock() >= nextQuest then
                nextQuest = os.clock() + Config.Quest.Interval
                local r = questRemote(boss)
                if r then pcall(function() r:FireServer(LocalPlayer) end) end
            end
            local part, model = findBossPart(boss, root.Position)
            local bossHum = model and model:FindFirstChildOfClass("Humanoid")
            if part and not (bossHum and bossHum.Health <= 0) then
                local target = part.Position + Vector3.new(0, height, 0)
                placeUnder(part, height)
                task.wait(t.VerifyWait)
                local after = getRoot()
                local dist = after and (after.Position - target).Magnitude
                if dist and dist <= t.VerifyRadius then
                    return true
                end
            end
        end
        task.wait(t.ReturnPoll)
    end
    return false
end

