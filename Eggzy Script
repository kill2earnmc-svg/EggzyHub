-- Quest 5. Fly + noclip on, camera/character looking straight down (above the boss) or up (under it), Offset studs from the boss,
-- press Q until the boss reads alive, then set its Humanoid.Health to 0 (same call the grind uses).
function T3.findFightBoss(mentorName)
    local t = Config.Mentor.Training5
    local pools = {}
    local folder = Workspace:FindFirstChild(t.BossFolder)
    if folder then pools[#pools + 1] = folder:GetChildren() end
    pools[#pools + 1] = Workspace:GetChildren()
    local want = mentorName and mentorName:lower() or nil
    for _, pool in ipairs(pools) do
        local best, bestScore = nil, -1
        for _, m in ipairs(pool) do
            if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local part = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChild("Head")
                if hum and part then
                    local score = (hum.Health > 0) and 1 or 0
                    if want and m.Name:lower():find(want, 1, true) then score += 2 end
                    if score > bestScore then best, bestScore = { m, hum, part }, score end
                end
            end
        end
        if best then return best[1], best[2], best[3] end
    end
    return nil
end

-- Teleporting to another server destroys this script. queue_on_teleport re-runs the hub there and
-- hands it a "resume training 5" flag. Needs a reload source: getgenv().EggzyHubReloadUrl (loadstring + HttpGet)
-- or the hub saved as Training5.ReloadFile in the executor workspace.
function T3.findReloadLoader()
    if T3.loader ~= nil then return T3.loader or nil, T3.loaderNote end
    local t = Config.Mentor.Training5
    local okE, genv = pcall(getgenv)
    local url = okE and genv and genv.EggzyHubReloadUrl
    if type(url) == "string" and url ~= "" then
        T3.loader, T3.loaderNote = string.format("loadstring(game:HttpGet(%q))()", url), "url"
        return T3.loader, T3.loaderNote
    end
    -- Best source: the full hub text carried inside the file that launched it (EggzyHubSolo.lua).
    local embedded = okE and genv and genv.EggzyHubSourceText
    if type(embedded) == "string" and #embedded > 1000 then
        local level = 0
        while embedded:find("]" .. string.rep("=", level) .. "]", 1, true) do level += 1 end
        local eq = string.rep("=", level)
        T3.loader = "getgenv().EggzyHubSourceText = [" .. eq .. "[" .. embedded .. "]" .. eq .. "]\n"
            .. "loadstring(getgenv().EggzyHubSourceText)()"
        T3.loaderNote = "embedded hub source (" .. #embedded .. " bytes)"
        return T3.loader, T3.loaderNote
    end
    local function viaFile(name)
        return string.format("loadstring(readfile(%q))()", name)
    end
    if isfile and readfile then
        local named = (okE and genv and genv.EggzyHubReloadFile) or t.ReloadFile
        if type(named) == "string" and isfile(named) then
            T3.loader, T3.loaderNote = viaFile(named), "file " .. named
            return T3.loader, T3.loaderNote
        end
        -- search the executor workspace for a file that starts with the hub's header line
        if listfiles then
            local seen = 0
            for _, root in ipairs({ "", "scripts", "Scripts", "autoexec" }) do
                local okL, files = pcall(listfiles, root)
                if okL and type(files) == "table" then
                    for _, f in ipairs(files) do
                        local lower = tostring(f):lower()
                        if (lower:sub(-4) == ".lua" or lower:sub(-4) == ".txt") and seen < 300 then
                            seen += 1
                            local okR, text = pcall(readfile, f)
                            if okR and type(text) == "string" and text:sub(1, 400):find("EggzyHub.lua (client-side Luau)", 1, true) then
                                T3.loader, T3.loaderNote = viaFile(f), "file " .. tostring(f)
                                return T3.loader, T3.loaderNote
                            end
                        end
                    end
                end
            end
        end
    end
    T3.loader, T3.loaderNote = false, "no reload source found (save the hub as " .. t.ReloadFile .. " in the executor workspace, or set getgenv().EggzyHubReloadUrl)"
    return nil, T3.loaderNote
end

