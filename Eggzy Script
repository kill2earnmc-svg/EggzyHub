    T3.aimUp = false
    if T3.aimBound then
        T3.aimBound = false
        pcall(function() RunService:UnbindFromRenderStep(T3_BIND) end)
    end
end

function T3.bindAim()
    if T3.aimBound then return end
    T3.aimBound = true
    RunService:BindToRenderStep(T3_BIND, Enum.RenderPriority.Camera.Value + 1, function()
        local cam = Workspace.CurrentCamera
        if not (Alive and State.Mentor and cam) then return end
        local camPos = cam.CFrame.Position
        if T3.aimUp then
            cam.CFrame = CFrame.lookAt(camPos, camPos + Vector3.yAxis, Vector3.zAxis)
            return
        end
        local tg = T3.aimTarget
        if not (tg and tg.Parent) then return end
        if (tg.Position - camPos).Magnitude < 0.5 then return end
        cam.CFrame = CFrame.lookAt(camPos, tg.Position)
    end)
end

function T3.startAim(target)
    T3.aimTarget = target
    T3.bindAim()
end

function T3.startAimUp()
    T3.aimUp = true
    T3.bindAim()
end

-- Quest 5. Fly + noclip on, camera/character looking straight up, stand Depth studs under the boss,
-- press Q until the boss reads alive, then set its Humanoid.Health to 0 (same call the grind uses).
function T3.findFightBoss(mentorName)
    local t = Config.Mentor.Training5
    local pools = {}
    local folder = Workspace:FindFirstChild(t.BossFolder)
    if folder then pools[#pools + 1] = folder:GetChildren() end
    pools[#pools + 1] = Workspace:GetChildren()
    local want = mentorName and mentorName:lower() or nil
    for _, pool in ipairs(pools) do
        local best, bestScore = nil, -1
        for _, m in ipairs(pool) do
            if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local part = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChild("Head")
                if hum and part then
                    local score = (hum.Health > 0) and 1 or 0
                    if want and m.Name:lower():find(want, 1, true) then score += 2 end
                    if score > bestScore then best, bestScore = { m, hum, part }, score end
                end
            end
        end
        if best then return best[1], best[2], best[3] end
    end
    return nil
end

-- Teleporting to another server destroys this script. queue_on_teleport re-runs the hub there and
-- hands it a "resume training 5" flag. Needs a reload source: getgenv().EggzyHubReloadUrl (loadstring + HttpGet)
-- or the hub saved as Training5.ReloadFile in the executor workspace.
function T3.findReloadLoader()
    if T3.loader ~= nil then return T3.loader or nil, T3.loaderNote end
    local t = Config.Mentor.Training5
    local okE, genv = pcall(getgenv)
    local url = okE and genv and genv.EggzyHubReloadUrl
    if type(url) == "string" and url ~= "" then
        T3.loader, T3.loaderNote = string.format("loadstring(game:HttpGet(%q))()", url), "url"
        return T3.loader, T3.loaderNote
    end
    local function viaFile(name)
        return string.format("loadstring(readfile(%q))()", name)
    end
    if isfile and readfile then
        local named = (okE and genv and genv.EggzyHubReloadFile) or t.ReloadFile
        if type(named) == "string" and isfile(named) then
            T3.loader, T3.loaderNote = viaFile(named), "file " .. named
            return T3.loader, T3.loaderNote
        end
        -- search the executor workspace for a file that starts with the hub's header line
        if listfiles then
            local seen = 0
            for _, root in ipairs({ "", "scripts", "Scripts", "autoexec" }) do
                local okL, files = pcall(listfiles, root)
                if okL and type(files) == "table" then
                    for _, f in ipairs(files) do
                        local lower = tostring(f):lower()
                        if (lower:sub(-4) == ".lua" or lower:sub(-4) == ".txt") and seen < 300 then
                            seen += 1
                            local okR, text = pcall(readfile, f)
                            if okR and type(text) == "string" and text:sub(1, 400):find("EggzyHub.lua (client-side Luau)", 1, true) then
                                T3.loader, T3.loaderNote = viaFile(f), "file " .. tostring(f)
                                return T3.loader, T3.loaderNote
                            end
                        end
                    end
                end
            end
        end
    end
    T3.loader, T3.loaderNote = false, "no reload source found (save the hub as " .. t.ReloadFile .. " in the executor workspace, or set getgenv().EggzyHubReloadUrl)"
    return nil, T3.loaderNote
end

function T3.queueReload()
    if T3.queued then return true, "already queued" end
    local q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
    if not q then return false, "executor has no queue_on_teleport" end
    local loader, note = T3.findReloadLoader()
    if not loader then return false, note end
    local code = 'repeat task.wait() until game:IsLoaded() and game:GetService("Players").LocalPlayer\n'
        .. 'getgenv().EggzyResume = "t5"\n' .. loader
    local okQ, err = pcall(q, code)
    if not okQ then return false, tostring(err) end
    T3.queued = true
    return true, "queued via " .. note
end

function T3.fight()
    local t, g = Config.Mentor.Training5, Config.Grind
    local function stillOn() return Alive and State.Mentor and not State.Grind end
    local prevFly, prevNoclip = State.Fly, State.Noclip
    local okName, mentorName = pcall(detectMentorName)
    if not (okName and mentorName) then mentorName = MentorInfo.name end

    State.Fly = true
    State.Noclip = true
    startFly()
    T3.startAimUp()

    local ok, result = pcall(function()
        local deadline = os.clock() + t.BossTimeout
        local aliveSince = nil
        while stillOn() and os.clock() < deadline do
            local model, hum, part = T3.findFightBoss(mentorName)
            if model then
                MentorInfo.phase = string.format("t5 under %s (hp %.0f)", model.Name, hum.Health)
                placeUnder(part, -t.Depth)
                if hum.Health > 0 then
                    aliveSince = aliveSince or os.clock()
                else
                    aliveSince = nil
                end
                if aliveSince and os.clock() - aliveSince >= t.AliveConfirm then
                    local killUntil = os.clock() + g.KillSeconds
                    while stillOn() and os.clock() < killUntil and model.Parent and hum.Health > 0 do
                        placeUnder(part, -t.Depth)
                        scriptZeroed[hum] = true
                        pcall(function() hum.Health = 0 end)
                        task.wait(g.KillStep)
                    end
                    return string.format("hp set to 0 on %s (hp now %.0f)", model.Name, hum.Health)
                end
            else
                aliveSince = nil
                MentorInfo.phase = "t5 waiting for boss"
            end
            pressKey(g.Key, g.KeyHold)
            task.wait(g.KeyDelay)
        end
        return "no living boss confirmed before timeout or stop"
    end)

    T3.stopAim()
    State.Noclip = prevNoclip
    State.Fly = prevFly
    if not prevFly then stopFly() end
    return ok, tostring(result)
end

-- Returns true when a throw hit (target gone / replaced / moved), false otherwise, plus a reason.
function T3.round(lookOnly)
    local t = Config.Mentor.Training3
    local function stillOn() return Alive and State.Mentor and not State.Grind end

    MentorInfo.phase = "t3 looking for target"
    local target
    local deadline = os.clock() + t.FindTimeout
    while stillOn() and os.clock() < deadline do
        target = T3.findTarget()
        if target then break end
        task.wait(t.Poll)
    end
    if not target then return false, "no target found" end

    T3.startAim(target)
    local ok, hit, reason = pcall(function()
        task.wait(t.AimSettle)
        local basePos = target.Position
        if lookOnly then
            MentorInfo.phase = "t4 looking"
            local untilL = os.clock() + Config.Mentor.Training4.LookTimeout
            while stillOn() and os.clock() < untilL do
                local cur = T3.findTarget()
                if cur ~= target then
                    return true, cur and "replaced by a new instance" or "target removed"
                end
                local moved = (cur.Position - basePos).Magnitude
                if moved > t.MoveThreshold then
                    return true, string.format("target moved %.1f studs", moved)
                end
                task.wait(t.Poll)
            end
            return false, "target did not change while looking"
        end
        for throw = 1, t.MaxThrows do
            if not stillOn() then return false, "stopped" end
            MentorInfo.phase = string.format("t3 throw %d", throw)
            local cam = Workspace.CurrentCamera
            if okVim and VIM and cam then
                local vp = cam.ViewportSize
                pcall(function() VIM:SendMouseMoveEvent(vp.X / 2, vp.Y / 2, game) end)
            end
            local ready = T3.lastThrowAt + t.ThrowCooldown
            while stillOn() and os.clock() < ready do
                task.wait(0.05)
            end
            if not stillOn() then return false, "stopped" end
            T3.lastThrowAt = os.clock()
            clickM1(t.M1Hold)
            local untilT = os.clock() + t.HitWait
            while stillOn() and os.clock() < untilT do
                local cur = T3.findTarget()
                if cur ~= target then
                    return true, cur and "replaced by a new instance" or "target removed"
                end
                local moved = (cur.Position - basePos).Magnitude
                if moved > t.MoveThreshold then
                    return true, string.format("target moved %.1f studs", moved)
                end
                task.wait(t.Poll)
            end
        end
        return false, "no hit after " .. t.MaxThrows .. " throws"
    end)
    T3.stopAim()
    if not ok then return false, tostring(hit) end
    return hit, reason
end

