-- Collects string-ish values stored on the local player (values, object values, string attributes).
-- Skips PlayerGui/Backpack/PlayerScripts, depth-limited so it stays cheap.
local function mentorCandidates()
    local out = {}
    local kws = Config.Mentor.DetectKeywords
    local function keyHit(n)
        local l = string.lower(n)
        for _, kw in ipairs(kws) do
            if l:find(kw, 1, true) then return true end
        end
        return false
    end
    local function visit(inst, path, depth)
        local kw = keyHit(inst.Name)
        if inst:IsA("StringValue") then
            out[#out + 1] = { path = path, raw = inst.Value, kw = kw }
        elseif inst:IsA("ObjectValue") and inst.Value then
            out[#out + 1] = { path = path, raw = inst.Value.Name, kw = kw }
        end
        for k, v in pairs(inst:GetAttributes()) do
            if type(v) == "string" then
                out[#out + 1] = { path = path .. "@" .. k, raw = v, kw = keyHit(k) }
            end
        end
        if depth < 3 then
            for _, c in ipairs(inst:GetChildren()) do
                if not (depth == 0 and MENTOR_SKIP[c.Name]) then
                    visit(c, path .. "." .. c.Name, depth + 1)
                end
            end
        end
    end
    visit(LocalPlayer, "LocalPlayer", 0)
    return out
end

local function detectMentorName()
    local folder = mentorMissionsFolder()
    if not folder then
        return nil, "missing Workspace." .. table.concat(Config.Mentor.RootPath, ".")
    end
    local byKey = {}
    for _, m in ipairs(folder:GetChildren()) do
        byKey[normKey(m.Name)] = m.Name
    end
    local cands = mentorCandidates()
    table.sort(cands, function(a, b) return (a.kw and 1 or 0) > (b.kw and 1 or 0) end)
    for _, c in ipairs(cands) do
        local key = normKey(c.raw)
        if key ~= "" and byKey[key] then
            return byKey[key], "player data: " .. c.path
        end
    end
    local def = Config.Mentor.Default
    if def and byKey[normKey(def)] then
        return byKey[normKey(def)], "default (captured)"
    end
    return nil, "no match"
end

