local function getMissionInfo(mission)
    local giver = mission:FindFirstChild("missiongiver")
    if not giver then return mission.Name, "Time unknown" end

    local timer = giver:FindFirstChild("timer", true)
    local timeFolder = timer and timer:FindFirstChild("time", true)
    local bossLabel = timeFolder and timeFolder:FindFirstChild("boss", true)
    local timeLabel = timeFolder and (timeFolder:FindFirstChild("timer", true) or timeFolder:FindFirstChild("time", true))

    local bossName = mission.Name
    if bossLabel and bossLabel:IsA("TextLabel") then
        bossName = bossLabel.Text:gsub("^%[", ""):gsub("%]$", "")
    end

    local timeText = "Time unknown"
    if timeLabel and timeLabel:IsA("TextLabel") then
        timeText = timeLabel.Text
    end

    return bossName, timeText
end

local function createScrollESP(part, mission, category)
    if trackedScrollParts[part] then return end
    trackedScrollParts[part] = true

    local billboard = Instance.new("BillboardGui")
