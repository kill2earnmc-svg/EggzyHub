}
-- Same recipe as the fullbright script you sent (it did not flicker): Ambient white, Brightness 1, FogEnd huge, the Bloom / Blur /
-- ColorCorrection / SunRays effects in Lighting turned off, and a PointLight on your HumanoidRootPart (Brightness 1, Range 60).
-- ClockTime, GlobalShadows, OutdoorAmbient and ExposureCompensation are left alone: the game animates them, which is what made mine flicker.
Config.Fullbright = {
    Lighting = { Ambient = Color3.fromRGB(255, 255, 255), Brightness = 1, FogEnd = 1e10 },
    EffectClasses = { "BloomEffect", "BlurEffect", "ColorCorrectionEffect", "SunRaysEffect" },
    LightName = "EggzyHeadlight", LightBrightness = 1, LightRange = 60,
    EffectScan = 0.25, -- seconds between passes that switch off effects the game adds later
}
State.Fullbright = false
State.BlindFB = false

for key, value in pairs(Config.Fullbright.Lighting) do
    track(Lighting:GetPropertyChangedSignal(key):Connect(function()
        if T3.fbActive then
            pcall(function()
                if Lighting[key] ~= value then Lighting[key] = value end
            end)
        end
    end))
end

-- Same effect as the Lighting.Changed hook in the script you sent: the game's own change is overwritten at once, not a frame later.
function T3.fbHandleEffect(inst)
    local fb = Config.Fullbright
    for _, className in ipairs(fb.EffectClasses) do
        if inst:IsA(className) then
            local saved = T3.fbSaved
            if saved and saved.effects[inst] == nil then
                saved.effects[inst] = inst.Enabled
                saved.conns[#saved.conns + 1] = inst:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if T3.fbActive and inst.Enabled then pcall(function() inst.Enabled = false end) end
                end)
            end
            if inst.Enabled then pcall(function() inst.Enabled = false end) end
            return
        end
    end
end

function T3.fbApply()
    local fb = Config.Fullbright
    if not T3.fbSaved then
        T3.fbSaved = { props = {}, effects = {}, conns = {} }
        for key in pairs(fb.Lighting) do
            local okR, value = pcall(function() return Lighting[key] end)
            if okR then T3.fbSaved.props[key] = value end
        end
        T3.fbSaved.conns[#T3.fbSaved.conns + 1] = Lighting.DescendantAdded:Connect(function(inst)
            if T3.fbActive then pcall(T3.fbHandleEffect, inst) end
        end)
        T3.fbActive = true
        for _, inst in ipairs(Lighting:GetDescendants()) do
            pcall(T3.fbHandleEffect, inst)
        end
    end
    for key, value in pairs(fb.Lighting) do
        pcall(function()
            if Lighting[key] ~= value then Lighting[key] = value end
        end)
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and not root:FindFirstChild(fb.LightName) then
        local light = Instance.new("PointLight")
        light.Name = fb.LightName
        light.Brightness = fb.LightBrightness
        light.Range = fb.LightRange
        light.Parent = root
    end
end

function T3.fbRestore()
    local saved = T3.fbSaved
    if saved then
        T3.fbActive = false
        for _, conn in ipairs(saved.conns) do pcall(function() conn:Disconnect() end) end
        for key, value in pairs(saved.props) do
            pcall(function() Lighting[key] = value end)
        end
        for inst, wasEnabled in pairs(saved.effects) do
            if inst.Parent then pcall(function() inst.Enabled = wasEnabled end) end
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local light = root and root:FindFirstChild(Config.Fullbright.LightName)
        if light then light:Destroy() end
        T3.fbSaved = nil
    end
end

function T3.blinded()
    local detect = Config.Blind.Detect
    if type(detect) ~= "function" then return false end
    local okD, result = pcall(detect)
    return okD and result == true
end

