local function normKey(s)
    return (string.lower(tostring(s or "")):gsub("[^%w]", ""))
end

local function nameHitsVillage(raw)
    if not raw or raw == "" then return nil end
    local lower = string.lower(raw)
    for _, entry in ipairs(VillageKeywords) do
        if lower:find(entry.key, 1, true) then
            return entry.name
        end
    end
    return nil
end

local function partPosition(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then
        local p = inst:FindFirstChild("HumanoidRootPart")
            or inst:FindFirstChild("Head")
            or inst:FindFirstChildWhichIsA("BasePart", true)
        return p and p.Position
    end
    local p = inst:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position
end

local function villageFromBossName(raw)
    if not raw or raw == "" then return nil end
    local key = normKey(raw)
    local direct = BossVillage[key]
    if direct then return direct end
    for bossKey, village in pairs(BossVillage) do
        if #bossKey >= 6 and (key:find(bossKey, 1, true) or bossKey:find(key, 1, true)) then
            return village
        end
    end
    -- do NOT fall back to nameHitsVillage here — mission names are boss names, not map names
    return nil
end

local function detectVillageFromWorld(fromPos)
    -- Collect hits, then majority-vote the closest cluster.
    -- No Y logic. No default to Nimbus.
    local hits = {} -- { name, dist }
    local SCAN = 6000

    local function push(name, pos)
        if not name or not pos then return end
        local d = (pos - fromPos).Magnitude
        if d > SCAN then return end
        hits[#hits + 1] = { name = name, dist = d }
    end

    local missionRoots = {
        Workspace:FindFirstChild("bossdropmission"),
        Workspace:FindFirstChild("HAPPYmission"),
        Workspace:FindFirstChild("Koramamission"),
        Workspace:FindFirstChild("missiongivers"),
    }
    for _, rootFolder in ipairs(missionRoots) do
        if rootFolder then
            local missions = rootFolder:FindFirstChild("missions") or rootFolder
            for _, mission in ipairs(missions:GetChildren()) do
                local hit = villageFromBossName(mission.Name)
                if hit then
                    local giver = mission:FindFirstChild("missiongiver")
                        or mission:FindFirstChild("CLIENTTALK", true)
                        or mission
                    push(hit, partPosition(giver))
                end
            end
            for _, child in ipairs(rootFolder:GetDescendants()) do
                local n = child.Name:lower()
                if n == "missiongiver" or n == "clienttalk" then
                    local parent = child.Parent
                    local hit = villageFromBossName(parent and parent.Name)
                        or villageFromBossName(parent and parent.Parent and parent.Parent.Name)
                    if hit then
                        push(hit, partPosition(child))
                    end
                end
            end
        end
    end

    local npcFolder = Workspace:FindFirstChild("npc")
    if npcFolder then
        for _, m in ipairs(npcFolder:GetChildren()) do
            if m:IsA("Model") then
                local pos = partPosition(m)
                if pos then
                    local key = normKey(m.Name)
                    local fromNt = m:FindFirstChild("npctype")
                    if fromNt and fromNt:IsA("StringValue") and fromNt.Value ~= "" then
                        key = normKey(fromNt.Value)
                    end
                    local bd = m:FindFirstChild("bossdrop")
                    if bd and bd:IsA("StringValue") and bd.Value ~= "" then
                        key = normKey(bd.Value):gsub("char$", "")
                    end
                    local village = BossVillage[key] or villageFromBossName(key)
                    if village then
                        push(village, pos)
                    end
                end
            end
        end
    end

    if #hits == 0 then
        if Config.Debug then
            print("[EggzyMap] no landmark hits")
        end
        return nil, math.huge
    end

    table.sort(hits, function(a, b) return a.dist < b.dist end)

    if Config.Debug then
        local parts = {}
        for i = 1, math.min(5, #hits) do
            parts[#parts + 1] = string.format("%s@%.0f", hits[i].name, hits[i].dist)
        end
        print("[EggzyMap] top:", table.concat(parts, " | "))
    end

    -- nearest single hit under 1200 always wins
    if hits[1].dist <= 1200 then
        return hits[1].name, hits[1].dist
    end

    -- otherwise majority among the 8 nearest
    local topN = math.min(8, #hits)
    local counts = {}
    local bestVote, bestVoteName = 0, hits[1].name
    local nearestFor = {}
    for i = 1, topN do
        local n = hits[i].name
        counts[n] = (counts[n] or 0) + 1
        if not nearestFor[n] then nearestFor[n] = hits[i].dist end
        if counts[n] > bestVote or (counts[n] == bestVote and nearestFor[n] < (nearestFor[bestVoteName] or math.huge)) then
            bestVote = counts[n]
            bestVoteName = n
        end
    end

    return bestVoteName, nearestFor[bestVoteName] or hits[1].dist
end

local _mapLockName = nil
local _mapLockScore = math.huge
local SWITCH_MARGIN = 800
local HARD_LOCK = 1200

track(RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if not _G._lastMapCheck or now - _G._lastMapCheck > 1.0 then
        _G._lastMapCheck = now
        local root = getRoot()
        if not root then return end

        local name, score = detectVillageFromWorld(root.Position)
        if not name or not score or score == math.huge then
            return
        end

        if not _mapLockName then
            _mapLockName, _mapLockScore = name, score
            CurrentVillage = name
            return
        end

        if name == _mapLockName then
            _mapLockScore = math.min(_mapLockScore, score)
            CurrentVillage = name
            return
        end

        if score <= HARD_LOCK or score + SWITCH_MARGIN < _mapLockScore then
            _mapLockName, _mapLockScore = name, score
            CurrentVillage = name
        end
    end
end))

