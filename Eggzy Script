-- M1 = left mouse button. Clicks at the viewport centre (not the cursor) so a click can never
-- land on the hub's own buttons.
local function sendMouse(down)
    local cam = Workspace.CurrentCamera
    if okVim and VIM then
        local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
        VIM:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, down, game, 0)
    elseif down then
