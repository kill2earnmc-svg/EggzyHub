local heldKeys = {}
local pressing = false -- false, or the os.clock() when an input routine started; older than 5 s counts as stale (a routine that died mid-press must not block input forever)
local mouseHeld = false

local function sendKey(down, keyCode)
    if okVim and VIM then
        VIM:SendKeyEvent(down, keyCode, false, game)
    elseif down then
        VirtualUser:KeyDown(keyCode)
    else
        VirtualUser:KeyUp(keyCode)
    end
end

-- M1 = left mouse button. Clicks at the viewport centre (not the cursor) so a click can never
-- land on the hub's own buttons.
local function sendMouse(down)
    local cam = Workspace.CurrentCamera
    if okVim and VIM then
        local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
        VIM:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, down, game, 0)
    elseif down then
        VirtualUser:Button1Down(Vector2.zero, cam and cam.CFrame or CFrame.new())
    else
        VirtualUser:Button1Up(Vector2.zero, cam and cam.CFrame or CFrame.new())
    end
end

local function forceReleaseInputs()
    for keyCode in pairs(heldKeys) do
        heldKeys[keyCode] = nil
        pcall(sendKey, false, keyCode)
    end
    if mouseHeld then
        mouseHeld = false
        pcall(sendMouse, false)
    end
end

local function sendChat(message)
    pcall(function()
        local textChatService = game:GetService("TextChatService")
        if textChatService.ChatInputBarConfiguration and textChatService.ChatInputBarConfiguration.TargetTextChannel then
            textChatService.ChatInputBarConfiguration.TargetTextChannel:SendAsync(message)
            return
        end
    end)
    pcall(function()
        local defaultChatSystemChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if defaultChatSystemChatEvents then
            local sayMessageRequest = defaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
            if sayMessageRequest then
                sayMessageRequest:FireServer(message, "All")
                return
            end
        end
    end)
end

