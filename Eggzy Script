-- Writes what the player's data and mission UI look like right now, so the "which quest am I on" source can be found.
T3.snapLog = {}
function T3.questSnapshot(tag)
    local lines = { string.format("== %s | %s | place %s job %s", tostring(tag), os.date("%X"), tostring(game.PlaceId), tostring(game.JobId)) }
    local statz = LocalPlayer:FindFirstChild("statz")
    if statz then
        for _, v in ipairs(statz:GetChildren()) do
            if v:IsA("ValueBase") and #lines < 120 then lines[#lines + 1] = "statz." .. v.Name .. " = " .. tostring(v.Value) end
        end
    end
    for k, v in pairs(LocalPlayer:GetAttributes()) do
        if #lines < 160 then lines[#lines + 1] = "attr " .. tostring(k) .. " = " .. tostring(v) end
    end
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then
        local n = 0
        for _, d in ipairs(pg:GetDescendants()) do
            if n >= 40 then break end
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible and d.Text ~= "" then
                local l = d.Text:lower()
                if l:find("training") or l:find("mission") or l:find("quest") or l:find("mentor") or l:find("sensei") then
                    n += 1
                    lines[#lines + 1] = "gui " .. d:GetFullName() .. ": " .. d.Text:sub(1, 90)
                end
            end
        end
    end
    T3.snapLog[#T3.snapLog + 1] = table.concat(lines, "\n")
    if writefile then pcall(writefile, Config.Mentor.QuestSnapshotFile, table.concat(T3.snapLog, "\n\n")) end
    if Config.Debug then print("[EggzyMentor] quest snapshot saved: " .. tostring(tag)) end
end

