-- WrenchSpy.lua (client-side Luau remote spy)
-- Logs every RemoteEvent:FireServer / UnreliableRemoteEvent:FireServer / RemoteFunction:InvokeServer
-- your own client sends, with the remote's path, its arguments, and a ready-to-paste call line.
-- Use: run it, then do the action once in game (talk to the rank-up NPC), then press Copy.
-- Needs an executor with hookmetamethod, getnamecallmethod, newcclosure, checkcaller.
-- Hotkeys: F8 = show/hide the window. Output file: WrenchSpy_out.txt (written by the Save button).

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Config = {
    MaxLines = 300,          -- log lines kept on screen
    MaxTableEntries = 40,    -- table entries printed per table
    MaxDepth = 4,            -- table nesting printed
    MaxStringLength = 200,   -- characters of a string argument printed
    ThrottleCalls = 8,       -- same remote more than this many times ...
    ThrottleWindow = 1,      -- ... inside this many seconds = auto-muted (noise filter)
    ShowOwnCalls = false,    -- true also logs calls made by executor scripts (checkcaller)
    OutFile = "WrenchSpy_out.txt",
}

if getgenv then
    local old = getgenv().WrenchSpyInstance
    if old and old.Stop then pcall(old.Stop) end
end

local missing = {}
for _, name in ipairs({ "hookmetamethod", "getnamecallmethod", "newcclosure", "checkcaller" }) do
    if not getfenv()[name] and not (getgenv and getgenv()[name]) then
        missing[#missing + 1] = name
    end
end
if #missing > 0 then
    warn("[WrenchSpy] this executor lacks: " .. table.concat(missing, ", ") .. " -- cannot hook remotes")
    return
end

local hookmetamethod_ = hookmetamethod or getgenv().hookmetamethod
local getnamecallmethod_ = getnamecallmethod or getgenv().getnamecallmethod
local newcclosure_ = newcclosure or getgenv().newcclosure
local checkcaller_ = checkcaller or getgenv().checkcaller

-- ---------------------------------------------------------------- pure formatting helpers
local function isIdentifier(s)
    return type(s) == "string" and s:match("^[%a_][%w_]*$") ~= nil
end

local function quote(s)
    s = tostring(s)
    local cut = false
    if #s > Config.MaxStringLength then
        s = s:sub(1, Config.MaxStringLength)
        cut = true
    end
    s = s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("[%c]", "?")
    return '"' .. s .. (cut and '..."' or '"')
end

-- game.Workspace.Folder["Odd Name"].Part  (first segment is the service)
local function instancePath(inst)
    local okChain, chain = pcall(function()
        local parts = {}
        local cur = inst
        local guard = 0
        while cur and cur ~= game and guard < 60 do
            parts[#parts + 1] = cur
            cur = cur.Parent
            guard += 1
        end
        if cur ~= game then return nil end
        return parts
    end)
    if not okChain or not chain then
        local okName, name = pcall(function() return inst:GetFullName() end)
        return "nil --[[ not in the game tree: " .. (okName and name or tostring(inst)) .. " ]]"
    end
    local out = "game"
    for i = #chain, 1, -1 do
        local node = chain[i]
        local okN, nm = pcall(function() return node.Name end)
        nm = okN and nm or "?"
        if i == #chain then
            out = 'game:GetService("' .. nm .. '")'
        elseif isIdentifier(nm) then
            out = out .. "." .. nm
        else
            out = out .. "[" .. quote(nm) .. "]"
        end
    end
    return out
end

local function serialize(v, depth, seen)
    local t = typeof(v)
    if t == "string" then
        return quote(v)
    elseif t == "number" then
        if v ~= v then return "0/0" end
        if v == math.huge then return "math.huge" end
        if v == -math.huge then return "-math.huge" end
        return tostring(v)
    elseif t == "boolean" or t == "nil" then
        return tostring(v)
    elseif t == "Instance" then
        if v == LocalPlayer then return "game:GetService(\"Players\").LocalPlayer" end
        return instancePath(v)
    elseif t == "Vector3" then
        return string.format("Vector3.new(%s, %s, %s)", v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return string.format("Vector2.new(%s, %s)", v.X, v.Y)
    elseif t == "CFrame" then
        local c = { v:GetComponents() }
        for i = 1, #c do c[i] = tostring(c[i]) end
        return "CFrame.new(" .. table.concat(c, ", ") .. ")"
    elseif t == "Color3" then
        return string.format("Color3.new(%s, %s, %s)", v.R, v.G, v.B)
    elseif t == "UDim2" then
        return string.format("UDim2.new(%s, %s, %s, %s)", v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "table" then
        if seen[v] then return "{ --[[ cycle ]] }" end
        if depth >= Config.MaxDepth then return "{ --[[ depth limit ]] }" end
        seen[v] = true
        local parts, count = {}, 0
        local isArray = #v > 0
        for k, val in pairs(v) do
            count += 1
            if count > Config.MaxTableEntries then
                parts[#parts + 1] = "--[[ more entries ]]"
                break
            end
            if isArray and type(k) == "number" then
                parts[#parts + 1] = serialize(val, depth + 1, seen)
            elseif isIdentifier(k) then
                parts[#parts + 1] = k .. " = " .. serialize(val, depth + 1, seen)
            else
                parts[#parts + 1] = "[" .. serialize(k, depth + 1, seen) .. "] = " .. serialize(val, depth + 1, seen)
            end
        end
        seen[v] = nil
        return "{ " .. table.concat(parts, ", ") .. " }"
    else
        return "nil --[[ " .. t .. " ]]"
    end
end

local function serializeArgs(args, n)
    local parts = {}
    for i = 1, n do
        parts[i] = serialize(args[i], 0, {})
    end
    return table.concat(parts, ", ")
end

-- ---------------------------------------------------------------- log state
local Alive = true
local Paused = false
local Lines = {}           -- { text = string, call = string }
local FullLog = {}         -- everything, for Save (capped)
local Muted = {}           -- remote full path -> true
local Counters = {}        -- remote full path -> { start = clock, n = count }
local Filter = ""
local onLogChanged = nil

local function pushLog(header, callLine)
    local entry = { text = header, call = callLine }
    Lines[#Lines + 1] = entry
    if #Lines > Config.MaxLines then table.remove(Lines, 1) end
    FullLog[#FullLog + 1] = header .. "\n" .. callLine
    if #FullLog > 2000 then table.remove(FullLog, 1) end
    if onLogChanged then onLogChanged() end
end

local function handleCall(remote, method, args, n)
    if not Alive or Paused then return end
    local okPath, path = pcall(instancePath, remote)
    if not okPath then return end

    local now = os.clock()
    local c = Counters[path]
    if not c or now - c.start > Config.ThrottleWindow then
        c = { start = now, n = 0 }
        Counters[path] = c
    end
    c.n += 1
    if Muted[path] then return end
    if c.n > Config.ThrottleCalls then
        Muted[path] = true
        pushLog(string.format("[%s] AUTO-MUTED (fires too often): %s", os.date("%H:%M:%S"), remote.Name), "-- " .. path)
        return
    end

    local okArgs, argText = pcall(serializeArgs, args, n)
    if not okArgs then argText = "--[[ could not print arguments ]]" end
    local header = string.format("[%s] %s  %s  (%d arg%s)", os.date("%H:%M:%S"), method, remote.Name, n, n == 1 and "" or "s")
    local callLine = string.format("%s:%s(%s)", path, method, argText)
    pushLog(header, callLine)
end

-- ---------------------------------------------------------------- hook
local Queue = {}
local Methods = { FireServer = true, InvokeServer = true }
local original
original = hookmetamethod_(game, "__namecall", newcclosure_(function(self, ...)
    local method = getnamecallmethod_()
    if Alive and Methods[method] and (Config.ShowOwnCalls or not checkcaller_()) then
        local okClass, isRemote = pcall(function()
            return typeof(self) == "Instance"
                and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction") or self:IsA("UnreliableRemoteEvent"))
        end)
        if okClass and isRemote then
            local n = select("#", ...)
            local args = { ... }
            Queue[#Queue + 1] = { self, method, args, n } -- processed on Heartbeat (the hook thread has no UI capability)
            if #Queue > 500 then table.remove(Queue, 1) end
        end
    end
    return original(self, ...)
end))

-- ---------------------------------------------------------------- window
local parentGui
do
    local okHui, hui = pcall(function() return gethui and gethui() end)
    parentGui = (okHui and hui) or game:GetService("CoreGui")
end

local old = parentGui:FindFirstChild("WrenchSpyGui")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "WrenchSpyGui"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.Parent = parentGui

local win = Instance.new("Frame")
