-- ===================== GRIND CYCLE LOGIC =====================
local lastEngaged = os.clock()

local function grindStep(boss)
    local g = Config.Grind
    local waitStart = os.clock()
    local nextFire = waitStart + Config.Quest.Interval
    local part, model, foundBoss
    while Alive and State.Grind and State.AutoQuest and os.clock() < waitStart + g.WaitSeconds do
        local root = getRoot()
        local fromPos = root and root.Position
        part, model = findBossPart(boss, fromPos)
        if part then
            foundBoss = boss
            break
        end
        for _, other in ipairs(Config.Bosses) do
            if other ~= boss and Config.Quest.Selected[other] then
                part, model = findBossPart(other, fromPos)
                if part then
                    foundBoss = other
                    break
                end
            end
        end
        if foundBoss then break end
        if os.clock() >= nextFire then
            nextFire = os.clock() + Config.Quest.Interval
            local r = questRemote(boss)
            if r then
                pcall(function() r:FireServer(LocalPlayer) end)
            end
        end
        task.wait(g.Poll)
    end
    if not foundBoss then
        return false
    end
    local engagedAt = os.clock()
    lastEngaged = engagedAt
    visited[model] = true
    local currentHeight = getBossHeight(foundBoss)
    placeUnder(part, currentHeight)

    local hum = model:FindFirstChildOfClass("Humanoid")
    local hit = Config.Kill.UseHitRemote and LocalPlayer:FindFirstChild(Config.Kill.RemoteName)
    local untilT = os.clock() + g.KillSeconds

    while Alive and State.Grind and os.clock() < untilT and model.Parent do
        placeUnder(part, currentHeight)
        
        local _, localHum = getRoot()
        if localHum then
            pcall(function()
                if localHum.MaxHealth < 300000 then
                    localHum.MaxHealth = 300000
                end
                localHum.Health = 300000
            end)
        end

        local isDead = (hum and hum.Health <= 0) or (not hum) or (not model.Parent)

        if not isDead then
            if hit and hit:IsA("BaseRemoteEvent") then 
                pcall(hit.FireServer, hit, "target", part) 
            end
            if hum then
                scriptZeroed[hum] = true
                pcall(function() hum.Health = 0 end)
            end
        else
            break
        end
        task.wait(g.KillStep)
    end
    return true
end

