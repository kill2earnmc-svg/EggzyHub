-- Is this boss's mission really present in the current map? Strict: the mission folder must exist here and hold the giver remote.
-- (questRemote also falls back to ANY CLIENTTALK under bossdropmission for firing, which made every boss look "in this map".)
function T3.inMap(boss)
    local folder = questFolder()
    if not folder then return false end
    local mission = folder:FindFirstChild(boss)
    if not mission then
        local key = string.lower(boss):gsub("[^%w]", "")
        for _, child in ipairs(folder:GetChildren()) do
            if (string.lower(child.Name):gsub("[^%w]", "")) == key then
                mission = child
                break
            end
        end
    end
    if not mission then return false end
    local cur = mission
    for _, n in ipairs(Config.Quest.GiverPath) do
        cur = cur and cur:FindFirstChild(n)
    end
    return cur ~= nil and (cur:IsA("RemoteEvent") or cur:IsA("BaseRemoteEvent"))
end

