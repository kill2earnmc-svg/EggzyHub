local function createValueRow(parent, label, getValue, setValue, step, minV, maxV, order)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3 = Theme.Surface
    row.BackgroundTransparency = 0.15
    row.BorderSizePixel = 0
    row.LayoutOrder = order or 0
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.BorderSoft
    stroke.Thickness = 1
    stroke.Transparency = 0.6
    stroke.Parent = row

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -140, 1, 0)
    nameLabel.Position = UDim2.fromOffset(12, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = label
    nameLabel.TextColor3 = Theme.Text
    nameLabel.Font = Enum.Font.GothamMedium
    nameLabel.TextSize = 12
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = row

    local function formatVal(v)
        if math.abs(v - math.floor(v + 0.0001)) < 0.001 then
            return tostring(math.floor(v + 0.0001))
        end
        return string.format("%.1f", v)
    end

    local valBox = Instance.new("TextBox")
    valBox.Size = UDim2.fromOffset(52, 22)
    valBox.Position = UDim2.new(1, -118, 0.5, -11)
    valBox.BackgroundColor3 = Theme.Off
    valBox.Text = formatVal(getValue())
    valBox.TextColor3 = Theme.Accent
    valBox.Font = Enum.Font.GothamBold
    valBox.TextSize = 12
    valBox.ClearTextOnFocus = false
    valBox.BorderSizePixel = 0
    valBox.Parent = row
    Instance.new("UICorner", valBox).CornerRadius = UDim.new(0, 5)

    local function commit(raw)
        local n = tonumber(raw)
        if not n then
            valBox.Text = formatVal(getValue())
            return
        end
        if n < minV then n = minV end
        if n > maxV then n = maxV end
        if step >= 1 then
            n = math.floor(n + 0.5)
        end
        setValue(n)
        valBox.Text = formatVal(n)
        applyMovement()
    end

    valBox.FocusLost:Connect(function(enter)
        commit(valBox.Text)
    end)

    local function makeBtn(text, xOff, delta)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(26, 22)
        b.Position = UDim2.new(1, xOff, 0.5, -11)
        b.BackgroundColor3 = Theme.Off
        b.Text = text
        b.TextColor3 = Theme.Text
        b.Font = Enum.Font.GothamBold
        b.TextSize = 14
        b.AutoButtonColor = false
        b.BorderSizePixel = 0
        b.Parent = row
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
        b.MouseButton1Click:Connect(function()
            local v = getValue() + delta
            if v < minV then v = minV end
            if v > maxV then v = maxV end
            setValue(v)
            valBox.Text = formatVal(v)
            applyMovement()
        end)
        return b
    end

    makeBtn("−", -80, -step)
    makeBtn("+", -48, step)

    return valBox
end

